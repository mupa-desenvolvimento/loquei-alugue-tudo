# Copie este arquivo para `.env` e preencha.
# Sem estas variáveis o app roda em modo demo (dados de exemplo, sem persistência).
#
# ATENÇÃO: tudo com prefixo VITE_ é embutido no bundle JavaScript e fica
# visível para qualquer visitante do site. Só coloque aqui valores públicos.
# Nunca ponha service_role, chaves de storage ou segredos de pagamento.

# Project Settings > API, no painel do Supabase
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
